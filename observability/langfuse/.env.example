# PostgreSQL role used by Langfuse and the PostgreSQL container.
POSTGRES_USER=changeme-postgres-user

# PostgreSQL password; use a strong URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changeme-generate-a-real-url-safe-value

# PostgreSQL database used by Langfuse.
POSTGRES_DB=changeme-postgres-database

# ClickHouse user used by Langfuse and the ClickHouse container.
CLICKHOUSE_USER=changeme-clickhouse-user

# ClickHouse password used by Langfuse and the ClickHouse container.
CLICKHOUSE_PASSWORD=changeme-generate-a-real-value

# Redis password used by Langfuse and required by the Redis server.
REDIS_AUTH=changeme-generate-a-real-value

# MinIO root/access-key user used for Langfuse S3-compatible storage.
MINIO_ROOT_USER=changeme-minio-user

# MinIO root/secret-access-key password used for Langfuse S3-compatible storage.
MINIO_ROOT_PASSWORD=changeme-generate-a-real-value

# Random salt used by Langfuse when hashing sensitive values.
SALT=changeme-generate-a-real-value

# Langfuse encryption key; replace with exactly 64 hexadecimal characters.
ENCRYPTION_KEY=changeme-generate-64-hex-characters

# Random secret used to sign Langfuse authentication sessions.
NEXTAUTH_SECRET=changeme-generate-a-real-value

# Stable identifier for the organization created on first boot.
LANGFUSE_INIT_ORG_ID=changeme-local-org-id

# Display name for the organization created on first boot.
LANGFUSE_INIT_ORG_NAME=changeme-local-org-name

# Stable identifier for the project created on first boot.
LANGFUSE_INIT_PROJECT_ID=changeme-local-project-id

# Display name for the project created on first boot.
LANGFUSE_INIT_PROJECT_NAME=changeme-local-project-name

# Public API key assigned to the first-boot project.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_changeme-generate-a-real-value

# Secret API key assigned to the first-boot project.
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_changeme-generate-a-real-value

# Email address for the initial organization owner.
LANGFUSE_INIT_USER_EMAIL=changeme-user@example.invalid

# Display name for the initial organization owner.
LANGFUSE_INIT_USER_NAME=changeme-local-user

# Password for the initial organization owner.
LANGFUSE_INIT_USER_PASSWORD=changeme-generate-a-real-value
